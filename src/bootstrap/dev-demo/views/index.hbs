<!doctype html>
<html lang="es">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Demo Aula Virtual</title></head>
<body>
  <main>
    <h1>Tareas de Aula Virtual</h1>
    <p>Entorno de prueba. La captura y la entrega son simuladas.</p>
    <form method="post" action="/__demo/search"><button>Buscar tareas</button></form>
    {{#if job}}
      <p role="status">{{job.label}}. {{job.summary}}</p>
      {{#if job.refreshing}}<script>setTimeout(() => location.reload(), 700);</script>{{/if}}
    {{/if}}
    <ul>
      {{#each tasks}}
        <li><a href="/__demo/tasks/{{taskId}}">{{title}}</a> · {{course}} · {{#if deadline}}{{deadline}}{{else}}Sin fecha{{/if}}</li>
      {{else}}
        <li>Aún no hay tareas. Inicia una búsqueda.</li>
      {{/each}}
    </ul>
  </main>
</body>
</html>
